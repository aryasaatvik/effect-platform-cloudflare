{
  "name": "effect-platform-cloudflare",
  "version": "0.1.0",
  "description": "Effect HTTP router runtime for Cloudflare Workers",
  "keywords": [
    "cloudflare-workers",
    "effect",
    "http",
    "typescript"
  ],
  "homepage": "https://github.com/aryasaatvik/effect-platform-cloudflare#readme",
  "bugs": "https://github.com/aryasaatvik/effect-platform-cloudflare/issues",
  "license": "MIT",
  "author": "Saatvik Arya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/effect-platform-cloudflare.git",
    "directory": "packages/effect-platform-cloudflare"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm --external effect && tsc -p tsconfig.build.json",
    "package:smoke": "bun pm pack --dry-run",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "effect": "4.0.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  }
}
